exam_data <- data.frame(
  name=c("Anu","Bala","Cathy","David","Eva"),
  score=c(85,72,90,65,78),
  attempts=c(1,2,1,3,2),
  qualify=c(TRUE,TRUE,TRUE,FALSE,TRUE)
)

print(exam_data)

print(exam_data[1,])
print(exam_data[,c("name","score")])

exam_data$grade <- c("A","B","A","C","B")
print(exam_data)

exam_data <- rbind(exam_data,
                   data.frame(name="Frank",score=88,
                              attempts=1,qualify=TRUE,
                              grade="A"))
print(exam_data)

exam_data <- cbind(exam_data,
                   result=c("Pass","Pass","Pass","Fail","Pass","Pass"))
print(exam_data)

sorted_data <- exam_data[order(exam_data$score),]
print(sorted_data)

write.csv(exam_data, "exam_data.csv", row.names=FALSE)
print("Data saved successfully")

