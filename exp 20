# Load data
data(ChickWeight)
# Convert Diet to factor
ChickWeight$Diet <- factor(ChickWeight$Diet)
# Create model
model <- lm(weight ~ Time + Diet,
            data=ChickWeight)
# Model result
summary(model)
# Predict weight
pred <- predict(model)
# Calculate error
error <- ChickWeight$weight - pred
# Mean Squared Error
mse <- mean(error^2)
print(mse)



