A. Boxplot
boxplot(iris$Sepal.Length,
        main="Boxplot of Sepal Length",
        ylab="Sepal Length")

        
B. Histogram
hist(iris$Sepal.Length,
     main="Histogram of Sepal Length",
     xlab="Sepal Length")

     
C. Bar Plot
barplot(table(iris$Species),
        main="Species Count",
        xlab="Species",
        ylab="Count")

        
D. Line Chart
x <- 1:5
y <- c(10, 20, 15, 30, 25)
plot(x, y, type="l",
     main="Line Chart",
     xlab="X",
     ylab="Y")

     
E. Scatter Plot
plot(iris$Sepal.Length,
     iris$Petal.Length,
     main="Sepal Length vs Petal Length",
     xlab="Sepal Length",
     ylab="Petal Length")
