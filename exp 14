# Load dataset
data(ChickWeight)
# Sort by weight
sorted <- ChickWeight[order(ChickWeight$weight), ]
print(head(sorted))
# Melt data
library(reshape2)
m <- melt(ChickWeight,
          id.vars = c("Chick", "Time", "Diet"))
print(head(m))
# Cast by Diet
result <- dcast(m, Diet ~ variable, mean)
print(result)



