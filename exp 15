# Load iris dataset
data(iris)
# 1. Dimensions
dim(iris)
# 2. Summary
summary(iris)
# 3. Standard deviation
sd(iris$Sepal.Length)
# 4. Quantiles
quantile(iris$Sepal.Length)
# 5. Group by Species
aggregate(Sepal.Length ~ Species, iris, mean)
# 6. Pivot table
table(iris$Species)
# 7. Create Sepal.Length categories
iris$Sepal_Category <- cut(
  iris$Sepal.Length,
  breaks = c(4, 5, 6, 7, 8),
  labels = c("Low", "Medium", "High", "Very High")
)
# Display categories
table(iris$Sepal_Category)


