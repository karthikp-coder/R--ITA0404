# Install once if needed
# install.packages("reshape2")
library(reshape2)
# Load dataset
data(airquality)
# Melt the data
m <- melt(airquality, id.vars = "Month")
print(head(m))
# Cast and calculate monthly average
result <- dcast(m, Month ~ variable, mean, na.rm = TRUE)
print(result)




